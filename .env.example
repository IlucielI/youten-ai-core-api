APP_NAME=code-base-golang
APP_ENV=development
APP_VERSION=0.1.0
GIT_HASH=dev
HTTP_PORT=8080

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_base_golang
POSTGRES_SSLMODE=disable
AUTO_MIGRATE=false

# Connection Pool Settings
DB_POOL_MAX_OPEN_CONN=25
DB_POOL_MAX_IDLE_CONN=10
DB_POOL_MAX_CONN_LIFETIME=30m
DB_POOL_MAX_CONN_IDLE_TIME=10m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_DIAL_TIMEOUT=10s
RABBITMQ_MANAGEMENT_PORT=15672


# S3 / MinIO Object Storage Configuration
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=youten
S3_REGION=us-east-1
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# MinIO Container Environment (loaded automatically by minio service via env_file)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Client Application HTTP Basic Auth Configuration
BASIC_AUTH_USERNAME=client-app
BASIC_AUTH_PASSWORD=supersecretclientkey

# JWT Configuration
JWT_SECRET=code-base-golang-jwt-secret-key
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Idempotency Cache TTL Configuration (supports 1s, 5s, 1m, 5m, 1h, 24h; default: 24h)
IDEMPOTENCY_TTL=24h

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Request-ID,Idempotency-Key
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12h

# Rate Limiter & Quota Configuration (-1 disables quota enforcement)
RATE_LIMITER_ENABLED=true
RATE_LIMITER_LIMIT=20.0
RATE_LIMITER_BURST=30
GUEST_DAILY_QUOTA=1
USER_DAILY_QUOTA=5

# SMTP Configuration (Mailpit default for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Application Notification
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# ==============================================================================
# AI Services & OmniRoute (OpenAI-Compatible Gateway)
# ==============================================================================

# Primary LLM API Key & Base URL (OmniRoute / OpenAI-Compatible)
LLM_API_KEY=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:20128/v1

# Model Selection
LLM_MODEL=gpt-4o-mini
STT_MODEL=deepgram/nova-3
EMBEDDING_MODEL=cf/@cf/baai/bge-m3
EMBEDDING_DIMENSION=1024

# RAG & Semantic Chunking Settings
RAG_CHUNK_TOKENS=300
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_TOP_K=5
